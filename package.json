{
  "name": "yurei-cs2-team",
  "version": "1.0.0",
  "description": "Yurei",
  "main": "desktop/main.cjs",
  "private": true,
  "author": "Yurei",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.yurei.cs2team",
    "productName": "Yurei",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "supabase-client.js",
      "yurei.png",
      "yurei.ico",
      "desktop/**/*",
      "package.json",
      "!server.py",
      "!redline.sqlite3",
      "!supabase/**/*",
      "!site/**/*",
      "!desktop/installer-work/**/*",
      "!release/**/*"
    ],
    "win": {
      "icon": "yurei.ico",
      "target": ["nsis"],
      "artifactName": "Yurei-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yurei"
    },
    "publish": {
      "provider": "github",
      "owner": "yureiproject",
      "repo": "yurei-cs2"
    }
  }
}
